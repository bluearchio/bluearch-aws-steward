{
  "schema_version": "0.2",
  "owner": "bluearch-aws-steward",
  "purpose": "Machine-readable backlog for future native rule, LocalEmu fixture, MCP, and remediation expansion.",
  "product_strategy": {
    "positioning": "Local MCP-native recommendation-to-remediation engine for AWS developers.",
    "primary_value": "Reduce the time and risk from a finding to a reviewed and verified AWS, IaC, or code fix.",
    "not_primary_value": "Competing with Prowler, AWS native services, or enterprise CNAPP products on detector count alone.",
    "delivery_priority": [
      "cross-source finding aggregation and deduplication",
      "live evidence refresh and business-value ranking",
      "IaC source mapping and validated patches",
      "focused investigation playbooks",
      "selective native rules that unlock those workflows",
      "multi-account team governance"
    ]
  },
  "status_values": ["candidate", "specification", "fixture_design", "implementation", "native"],
  "objective_values": [
    "cost_optimization",
    "security",
    "reliability",
    "operations",
    "performance",
    "sustainability"
  ],
  "remediation_modes": [
    "planning_only",
    "guarded_aws_apply",
    "iac_patch",
    "code_patch",
    "debug_workflow"
  ],
  "localemu_modes": ["native", "overlay", "stub", "external_fixture", "not_supported"],
  "selection_policy": {
    "next_selection_target": 20,
    "wave_selection_targets_are_not_rule_count_commitments": true,
    "native_rule_gate": [
      "catalog mapping or explicit new rule proposal",
      "read-only provider capabilities",
      "positive finding test",
      "healthy resource test",
      "pagination test",
      "partial permission test",
      "redacted evidence test",
      "LocalEmu fixture proof or documented emulator limitation",
      "remediation plan template",
      "verification predicate",
      "docs and prompt examples"
    ],
    "prioritization_factors": [
      "customer impact",
      "frequency in real AWS accounts",
      "evidence quality",
      "LocalEmu feasibility",
      "safe remediation potential",
      "IaC mapping potential",
      "false-positive risk",
      "ability to unlock an investigation or verified fix",
      "incremental value beyond AWS native services and Prowler"
    ]
  },
  "waves": [
